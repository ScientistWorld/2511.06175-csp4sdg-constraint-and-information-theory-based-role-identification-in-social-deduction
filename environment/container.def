# Apptainer definition file for CSP4SDG environment.
#
# Build:  apptainer build container.sif container.def
#
# Packages Python-level dependencies via setup.sh (not here).
# This image is for running the CSP4SDG constraint-satisfaction solver,
# which requires no GPU and runs purely on CPU.

Bootstrap: docker
From: alpine:3.19

%post
    apk add --no-cache python3 py3-pip bash nano less curl wget git vim

    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
