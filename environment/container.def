# Apptainer definition file for CSP4SDG environment.
# Pure Python CSP solver — only standard library needed.
# CSP4SDG: Constraint-Satisfaction Framework for Social Deduction Games

Bootstrap: docker
From: python:3.11-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        procps vim less curl git \
    && rm -rf /var/lib/apt/lists/*


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into the container overlay.
    #
    # CSP4SDG is a pure-Python constraint-satisfaction solver.
    # Only the Python standard library is used — no external packages needed.
    #
    # This script runs inside the Apptainer overlay on compute nodes.
    # Use uv pip install --system for speed (uv is pre-installed in the base image).
    
    set -e
    
    echo "CSP4SDG environment setup complete (no external packages needed — pure Python)."

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user
