# Apptainer definition file for CSP4SDG environment.
# CSP4SDG is a pure Python CSP solver. No external packages needed.

Bootstrap: docker
From: debian:bookworm-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip nano less curl wget git vim bash procps && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
